# please don't kill yourself unless it's allowed
dontaudit { fsck toolbox vdc zygote } self:capability kill;

# We never apply OTAs when GSI is running
dontaudit hal_bootctl_default gsi_metadata_file:dir search;

# too noisy, and shouldn't even be granted by default unless necessary
dontaudit { gmscore_app hal_camera_default flags_health_check } property_type:file r_file_perms;
dontaudit {
  rild
  vendor_hal_neuralnetworks_default
  vendor_qti_init_shell
} default_prop:file r_file_perms;

# why would a script want to access rootfs?
dontaudit vendor_wcnss_service rootfs:dir { open read };

# untrusted_app shouldn't be allowed to read SELinux status
dontaudit untrusted_app_all selinuxfs:file read;

# all other no-context attempt by apps (as spotted on iQIYI)
dontaudit untrusted_app_all sysfs_net:dir search;

dontaudit {
  hal_audio_default
  hal_graphics_composer_default
  hal_sensors_default
  rild
  vendor_adpl
  vendor_cnd
  vendor_dpmd
  vendor_hal_imsrtp
  vendor_ims
  vendor_netmgrd
  vendor_qti
} vendor_diag_device:chr_file rw_file_perms;

dontaudit untrusted_app proc_tty_drivers:file { read open getattr };
dontaudit untrusted_app qemu_hw_prop:file { read open getattr };
dontaudit untrusted_app self:netlink_route_socket { bind nlmsg_readpriv nlmsg_getneigh };
dontaudit priv_app device:dir open;
dontaudit untrusted_app_29 cgroup:dir search;
dontaudit untrusted_app lmkd_prop:file { open getattr map };

# The QTI perf HAL probes /sys/kernel/mm/ksm/{sleep_millisecs,pages_to_scan}
# on every boot. KSM is compiled in but left disabled (ksm/run == 0), so the
# reads serve no purpose here. Generic sysfs, so granting it would open far
# more than KSM; just silence it.
dontaudit vendor_hal_perf_default sysfs:file r_file_perms;

# system_server probes ro.vendor.product.ztename, which does not exist on this
# device and therefore falls back to vendor_default_prop. Reading vendor
# default props from a coredomain is intentionally not allowed.
dontaudit system_server vendor_default_prop:file r_file_perms;

# crash_dump writes the crashing process' memfd when an app (e.g. Termux)
# spawns a native child that dies. Harmless and noisy.
dontaudit crash_dump tmpfs:file write;

# platform_app (systemui) probes ro.usb.uvc.enabled, which is not set on
# this device. The property exists in the vendor prop file but is unset.
dontaudit platform_app usb_uvc_enabled_prop:file r_file_perms;
