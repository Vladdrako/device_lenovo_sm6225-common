allow kernel per_boot_file:file r_file_perms;
allow kernel vendor_firmware_file:dir search;
allow kernel vendor_firmware_file:file r_file_perms;
allow kernel vendor_firmware_file:lnk_file read;
allow kernel vendor_file:file r_file_perms;
allow kernel self:capability dac_read_search;
allow kernel self:qipcrtr_socket create_socket_perms_no_ioctl;
dontaudit kernel mnt_vendor_file:dir search;
dontaudit kernel vendor_persist_audio_file:dir search;
dontaudit kernel vendor_persist_audio_file:file { open read };

allow kernel kernel:capability kill;
allow kernel debugfs_mmc:dir search;
