set_prop(vendor_init, vendor_alarm_boot_prop)
set_prop(vendor_init, vendor_video_prop)
set_prop(vendor_init, vendor_powerhal_prop)
set_prop(vendor_init, vendor_camera_prop)

allow vendor_init proc_dirty:file w_file_perms;

allow vendor_init vendor_ipa_dev:file create_file_perms;
allow vendor_init input_device:chr_file { create setattr unlink rw_file_perms };

allow vendor_init block_device:blk_file setattr;
allow vendor_init block_device:lnk_file setattr;

set_prop(vendor_init, vendor_verity_prop)
set_prop(vendor_init, vendor_dolby_prop)
set_prop(vendor_init, vendor_vulkan_prop)
