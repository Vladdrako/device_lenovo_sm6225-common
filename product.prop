# Audio
audio.offload.min.duration.secs=30
audio.sys.offload.pstimeout.secs=3
ro.config.vc_call_vol_steps=11

# App freezer
ro.config.use_freezer=true

# eBPF
ro.bpf.kver_override=5.10.239

# LMKD
ro.lmk.use_psi=true
ro.lmk.use_new_strategy=true
ro.lmk.kill_heaviest_task=true
ro.lmk.psi_partial_stall_ms=50
ro.lmk.psi_complete_stall_ms=120
ro.lmk.swap_free_low_percentage=5
ro.lmk.swap_util_max=90
ro.lmk.thrashing_limit=30
ro.lmk.thrashing_limit_decay=25
ro.lmk.thrashing_limit_critical=30
ro.lmk.filecache_min_kb=180000

# System server
arm64.memtag.process.system_server=off

# Voice assistant
ro.opa.eligible_device=true

ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=1024
multimedia.camera.frame.buffers=4
video.allocate.buffers=4
media.stagefright.max-alloc-buffers=4
debug.stagefright.ccodec=4
render.disable_shared_egl_context=1
