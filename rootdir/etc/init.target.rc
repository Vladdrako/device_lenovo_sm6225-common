on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules audio_q6_pdr audio_q6_notifier audio_snd_event audio_apr audio_adsp_loader audio_q6 audio_native audio_usf audio_pinctrl_lpi audio_swr audio_swr_ctrl audio_platform audio_stub audio_wcd_core audio_wcd9xxx audio_wsa881x_analog audio_bolero_cdc audio_va_macro audio_rx_macro audio_tx_macro audio_mbhc audio_wcd937x audio_wcd937x_slave audio_pm2250_spmi audio_rouleur audio_rouleur_slave audio_machine_bengal
    write /proc/sys/kernel/sched_boost 1

on early-init
        exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules audio_aw882xx

on init
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1
    #Moving to init as this is needed for qseecomd
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    start vendor.qseecomd

on fs
    start hwservicemanager
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    # --force ignores the cached security.sehash digest, which would otherwise
    # make this skip the pre-existing unlabeled files under persist/sensors.
    # This runs before the early-boot pass in init.qcom.rc, so it has to force
    # too, otherwise it just refreshes the digest and the later pass is a no-op.
    restorecon_recursive --force /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system
    chown system system /lenovocust
    chmod 0771 /lenovocust
    restorecon_recursive /lenovocust
    chmod 0444 /dev/goodix_penraw

on late-fs
    mount_all --late

on post-fs-data
    mkdir /vendor/data/tombstones 0771 system system

on boot
    write /dev/cpuset/audio-app/cpus 1-2
    # Add a cpuset for the camera daemon
    # We want all cores for camera
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0-7
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks

    # USB controller configuration
    #setprop vendor.usb.rndis.func.name "gsi"
    #setprop vendor.usb.rmnet.func.name "gsi"
    setprop vendor.usb.rndis.func.name "rndis"
    setprop vendor.usb.rmnet.func.name "rmnet"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    setprop vendor.usb.qdss.inst.name "qdss"
    setprop vendor.usb.controller 4e00000.dwc3

    # Sensor
    start vendor.sensors

    mkdir /sys/kernel/debug/tracing/instances/wifi 0755 system system
    chown system system /sys/kernel/debug/tracing/instances/wifi/free_buffer

on boot && property:persist.vendor.usb.controller.default=*
    setprop vendor.usb.controller ${persist.vendor.usb.controller.default}

on charger
    start vendor.power_off_alarm
    setprop vendor.usb.controller 4e00000.dwc3
    setprop sys.usb.configfs 1

service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

# -OAK-731,zhangchangfeng.wt,ADD,2021/12/10,delete telephony
on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy


on property:vendor.wlan.driver.status=ok
    start wificond

# Persistent bring-up logs on /cache (lenovocust, ext4, mounted by
# 'mount_all --early' in 'fs', not covered by userdata checkpointing).
# - rotating logcat of every buffer including kernel (no kmsg limits here)
# - sscrpcd:S again: its 25ms crash loop would rotate the real boot out of
#   the 10MB window within minutes
service cache_logcat /system/bin/logcat -b all -v threadtime -f /cache/logs/logcat.txt -r 2048 -n 4 sscrpcd:S *:V
    user root
    group root log
    oneshot
    disabled
    seclabel u:r:logger:s0

on post-fs && property:ro.debuggable=1
    mkdir /cache/logs 0770 root root
    wait_for_prop logd.ready true
    start cache_logcat
